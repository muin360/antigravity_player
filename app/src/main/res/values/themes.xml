<resources>
    <!-- Base app theme (used by Compose; minimal since Compose owns rendering) -->
    <style name="Theme.AntigravityPlayer" parent="android:Theme.Material.NoActionBar" />

    <!-- Splash Screen theme (Android 12+ SplashScreen API) -->
    <style name="Theme.AntigravityPlayer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0E1A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AntigravityPlayer</item>
    </style>
</resources>
